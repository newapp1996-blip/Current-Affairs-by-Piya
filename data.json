name: AURA Exam AI - Auto Update

on:

  # ==========================================================
  # UPDATE EVERY 3 HOURS - INDIA TIME
  # ==========================================================
  schedule:

    - cron: "30 0,3,6,9,12,15,18,21 * * *"
      timezone: "Asia/Kolkata"

  # Manual update button
  workflow_dispatch:


# ==========================================================
# PERMISSIONS
# ==========================================================

permissions:
  contents: write
  pages: write
  id-token: write


# ==========================================================
# JOB
# ==========================================================

jobs:

  update-news:

    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}


    steps:

      # ------------------------------------------------------
      # 1. CHECKOUT
      # ------------------------------------------------------

      - name: Checkout repository
        uses: actions/checkout@v4


      # ------------------------------------------------------
      # 2. PYTHON
      # ------------------------------------------------------

      - name: Set up Python
        uses: actions/setup-python@v5

        with:
          python-version: "3.11"


      # ------------------------------------------------------
      # 3. INSTALL DEPENDENCIES
      # ------------------------------------------------------

      - name: Install Dependencies
        run: |

          python -m pip install --upgrade pip

          pip install feedparser


      # ------------------------------------------------------
      # 4. GENERATE CURRENT AFFAIRS
      # ------------------------------------------------------

      - name: Generate Current Affairs

        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}

        run: |

          python update_news.py


      # ------------------------------------------------------
      # 5. VERIFY DATA
      # ------------------------------------------------------

      - name: Verify data.json

        run: |

          if [ ! -f data.json ]; then

            echo "ERROR: data.json was not created."

            exit 1

          fi


          python - <<'PY'

          import json

          with open(
              "data.json",
              "r",
              encoding="utf-8"
          ) as f:

              data = json.load(f)


          news = data.get(
              "news",
              []
          )

          quizzes = data.get(
              "quizzes",
              []
          )


          print(
              "News items:",
              len(news)
          )

          print(
              "Quiz items:",
              len(quizzes)
          )


          if len(news) < 12:

              raise SystemExit(
                  "ERROR: Less than 12 news items."
              )


          if len(quizzes) < 4:

              raise SystemExit(
                  "ERROR: Less than 4 quizzes."
              )


          print(
              "data.json verification successful."
          )

          PY


      # ------------------------------------------------------
      # 6. COMMIT DATA.JSON
      # ------------------------------------------------------

      - name: Commit Updated Data

        run: |

          git config --global user.name \
            "github-actions[bot]"

          git config --global user.email \
            "github-actions[bot]@users.noreply.github.com"


          git add data.json


          if git diff --cached --quiet; then

            echo "No data changes."

          else

            git commit \
              -m "Auto-updated current affairs"

            git push

          fi


      # ------------------------------------------------------
      # 7. CONFIGURE GITHUB PAGES
      # ------------------------------------------------------

      - name: Setup Pages

        uses: actions/configure-pages@v5


      # ------------------------------------------------------
      # 8. UPLOAD WEBSITE
      # ------------------------------------------------------

      - name: Upload Pages Artifact

        uses: actions/upload-pages-artifact@v4

        with:
          path: "."


      # ------------------------------------------------------
      # 9. DEPLOY WEBSITE
      # ------------------------------------------------------

      - name: Deploy to GitHub Pages

        id: deployment

        uses: actions/deploy-pages@v4
